# Copy to .env, then fill in one or more keys locally. Never commit .env.
# Fallback order is fixed:
# Gemini -> Groq Qwen -> Zhipu GLM -> SiliconFlow Qwen -> OpenRouter Free.
# Multiple Gemini keys can be comma-separated in priority order.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides. Comma-separated models are tried from left to right.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=qwen/qwen3.6-27b
ZHIPU_MODEL=glm-4.7-flash
SILICONFLOW_MODEL=Qwen/Qwen3.5-4B
OPENROUTER_MODEL=openrouter/free
# Optional candidate catalogs managed by Settings -> Models & API.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-pro
PORT=8787
X_TO_XHS_HOST=127.0.0.1
# X_TO_XHS_DATA_DIR=/absolute/path/to/local-data
